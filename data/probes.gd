## Каким способом распознаётся тег (для справочника).
static func how(tag: String) -> String:
	if tag in VISIBLE:
		return "видно при касании (Z)"
	for id in ORDER:
		if tag in PROBES[id].tags:
			return "проба «%s»" % PROBES[id].n
	return "только наблюдением: как ведёт себя в контейнере или машине"

static func probe_of(tag: String) -> String:
	for id in ORDER:
		if tag in PROBES[id].tags:
			return id
	return ""
