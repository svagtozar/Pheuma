class_name Events
## События планеты. У каждого — предупреждение, активная фаза, угроза и возможность.
##
##   warn, dur — диапазоны длительности фаз, с
##   w         — базовый вес
##   req       — нужен хотя бы один из тегов планеты
##   planet    — множители веса по тегам планеты
##   radius    — радиус зоны (0 — вся планета)

const EVENTS := {
	"meteors": {"n": "Метеоритный дождь", "warn": [30.0, 40.0], "dur": [40.0, 60.0], "w": 1.0, "radius": 6,
		"planet": {"thin_atmosphere": 2.5, "low_gravity": 1.5, "dense_atmosphere": 0.4},
		"tip": "Уведите робота из круга. Постройки в зоне пострадают, зато на месте падений появятся новые залежи."},
	"geyser": {"n": "Газовый гейзер", "warn": [20.0, 30.0], "dur": [120.0, 180.0], "w": 0.7, "radius": 1,
		"planet": {"volcanic": 3.0, "seismic": 2.0, "oceanic": 2.0},
		"tip": "Поставьте насос, трубу или бак рядом с гейзером — он бесплатно накачает газ в сеть."},
	"storm": {"n": "Сильная буря", "warn": [30.0, 40.0], "dur": [60.0, 90.0], "w": 1.5, "radius": 0, "req": ["storms"],
		"tip": "Пушки мажут втрое сильнее, лёгкие постройки ломаются. Держатся якорные и плотные материалы."},
	"quake": {"n": "Землетрясение", "warn": [25.0, 35.0], "dur": [15.0, 20.0], "w": 1.5, "radius": 0, "req": ["seismic"],
		"tip": "Трубы порвутся, появятся новые расщелины — и новые залежи."},
	"acid": {"n": "Кислотный ливень", "warn": [30.0, 40.0], "dur": [60.0, 90.0], "w": 1.2, "radius": 0, "req": ["acid_rain", "oceanic"],
		"tip": "Открытые контейнеры разъедает втрое быстрее. Переложите груз в закрытые баки."},
	"flare": {"n": "Аномальная вспышка", "warn": [25.0, 35.0], "dur": [40.0, 60.0], "w": 1.5, "radius": 7, "req": ["anomalous_field", "ancient_ruins"],
		"tip": "Грузы в открытых контейнерах внутри зоны получат случайные теги — иногда невозможные."},
	"temp_shift": {"n": "Перепад температуры", "warn": [40.0, 50.0], "dur": [90.0, 120.0], "w": 0.8, "radius": 0,
		"planet": {"tidally_locked": 3.0, "frozen": 1.5, "volcanic": 1.5},
		"tip": "Среда на время станет на 40 °C другой: летучее закипит или жидкое застынет."},
}

static func weight(id: String, planet: Planet) -> float:
	var d: Dictionary = EVENTS[id]
	var req: Array = d.get("req", [])
	if not req.is_empty():
		var ok := false
		for t in req:
			if planet.has_tag(t):
				ok = true
		if not ok:
			return 0.0
	var w: float = d.w
	for t in planet.tags:
		w *= d.get("planet", {}).get(t, 1.0)
	return w
